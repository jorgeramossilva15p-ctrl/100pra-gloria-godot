; 100 PRA GLÓRIA — protótipo inicial
; Godot 4.x

config_version=5

[application]
config/name="100 PRA GLÓRIA"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.055, 1)

[input]
move_up={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]}
pass_shoot={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":32)]}
p2_up={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":73)]}
p2_down={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":75)]}
p2_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":74)]}
p2_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":76)]}
p2_action={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194309)]}

[gui]
theme/default_font_multichannel_signed_distance_field=true
